-- Improved Ping Adjuster: uses multiple Roblox ping stats with fallbacks,
-- debounces pauses, and never permanently gets stuck in the paused state.
local pingAdjusterEnabled = true
local pausePing = 250
local resumePing = 200
local pauseDuration = 1
local pingPaused = false
local lastKnownPing = 0
local pingStatusLabel = FarmingTab:AddLabel("Ping: -- ms | Status: Ready")
pingStatusLabel.TextSize = 16

local pingAdjusterSwitch = FarmingTab:AddSwitch("Ping Adjuster", function(state)
    pingAdjusterEnabled = state
