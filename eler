local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getHumanoid()
    local character = Player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRootPart()
    local character = Player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getTool(toolName)
    local character = Player.Character
    local backpack = Player:FindFirstChild("Backpack")

    return
        (character and character:FindFirstChild(toolName))
        or
        (backpack and backpack:FindFirstChild(toolName))
end

local function formatRebirthNumber(number)
    if number >= 1e15 then
        return string.format("%.2fQ", number / 1e15)
    elseif number >= 1e12 then
        return string.format("%.2fT", number / 1e12)
    elseif number >= 1e9 then
        return string.format("%.2fB", number / 1e9)
    elseif number >= 1e6 then
        return string.format("%.2fM", number / 1e6)
    elseif number >= 1e3 then
        return string.format("%.2fK", number / 1e3)
    end

    return string.format("%.0f", number)
end

local function formatStatNumber(number)
    local negative = number < 0
    number = math.abs(number)

    local result

    if number >= 1e15 then
        result = string.format("%.2fQa", number / 1e15)
    elseif number >= 1e12 then
        result = string.format("%.2fT", number / 1e12)
    elseif number >= 1e9 then
        result = string.format("%.2fB", number / 1e9)
    elseif number >= 1e6 then
        result = string.format("%.2fM", number / 1e6)
    elseif number >= 1e3 then
        result = string.format("%.2fK", number / 1e3)
    else
        result = string.format("%.2f", number)
    end

    return negative and "-" .. result or result
end

local function sendNotification(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3
        })
    end)
end

