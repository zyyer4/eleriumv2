local function getJohnnyGuiRoot()
    local root
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then
            root = result
        end
    end
    if not root then
        local ok, result = pcall(function() return game:GetService("CoreGui") end)
        if ok and typeof(result) == "Instance" then
            root = result
        end
    end
    if not root then
        root = Player:WaitForChild("PlayerGui")
    end
    return root
end

local function findMainJohnnyGui()
    local roots = { getJohnnyGuiRoot() }
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function() table.insert(roots, Player:WaitForChild("PlayerGui")) end)

    for _, root in ipairs(roots) do
        if root and typeof(root) == "Instance" then
            local found = root:FindFirstChild("imgui", true)
            if found then
                return found
            end
        end
    end
    return nil
end

local function destroyMainUiForCompactMode()
    local imgui = findMainJohnnyGui()
    if imgui then
        pcall(function() imgui:Destroy() end)
    end
end

local function destroyCompactMode()
    if compactModeGui then
        pcall(function() compactModeGui:Destroy() end)
        compactModeGui = nil
    end
    local root = getJohnnyGuiRoot()
    pcall(function()
        local old = root:FindFirstChild("JohnnyCompactMode")
        if old then old:Destroy() end
    end)
end

