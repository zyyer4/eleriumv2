        pingPaused = false
        updatePingStatus("Disabled")
    end
end)
pingAdjusterSwitch:Set(true)

FarmingTab:AddTextBox("Pause At Ping (ms)", function(value)
    local n = tonumber(value)
    if n and n >= 1 then
        pausePing = math.floor(n)
        if resumePing >= pausePing then
            resumePing = math.max(0, pausePing - 25)
        end
    end
end, { placeholder = "250" })

FarmingTab:AddTextBox("Resume Below Ping (ms)", function(value)
    local n = tonumber(value)
    if n and n >= 0 then
        resumePing = math.min(math.floor(n), math.max(0, pausePing - 1))
    end
end, { placeholder = "200" })

FarmingTab:AddTextBox("Pause Duration (seconds)", function(value)
    local n = tonumber(value)
    if n and n >= 0 then
        pauseDuration = n
    end
end, { placeholder = "1" })

local function readPingStat(stat)
    if not stat then return nil end
    local ok, value = pcall(function()
        return stat:GetValue()
    end)
    if ok and type(value) == "number" and value >= 0 then
        return value
    end
    local okString, valueString = pcall(function()
        return stat:GetValueString()
    end)
    if okString and type(valueString) == "string" then
        local n = tonumber(valueString:match("([%d%.]+)"))
        if n then return n end
    end
    return nil
end

local function getPing()
    local stats = game:GetService("Stats")
    local candidates = {
        stats:FindFirstChild("Network") and stats.Network:FindFirstChild("ServerStatsItem") and stats.Network.ServerStatsItem:FindFirstChild("Data Ping"),
        stats:FindFirstChild("PerformanceStats") and stats.PerformanceStats:FindFirstChild("Ping"),
        stats:FindFirstChild("Network") and stats.Network:FindFirstChild("ServerStatsItem") and stats.Network.ServerStatsItem:FindFirstChild("Ping"),
    }
    for _, stat in ipairs(candidates) do
        local value = readPingStat(stat)
        if value then
            lastKnownPing = value
            return value
        end
    end
    return lastKnownPing
end

local function updatePingStatus(status)
    local ping = getPing()
    pingStatusLabel.Text = string.format("Ping: %d ms | Status: %s", math.floor(ping + 0.5), status)
end

local function waitForPingRecovery()
    if pauseDuration > 0 then
        local finish = tick() + pauseDuration
        while runFastRep and pingAdjusterEnabled and tick() < finish do
            updatePingStatus("Paused - cooldown")
            task.wait(0.1)
        end
    end

    while runFastRep and pingAdjusterEnabled do
        local ping = getPing()
        if ping < resumePing then
            break
        end
        updatePingStatus("Paused - waiting for recovery")
        task.wait(0.15)
    end

    pingPaused = false
    if runFastRep then
        updatePingStatus(pingAdjusterEnabled and "Running" or "Disabled")
    end
end

local function fastRepLoop()
    while runFastRep do
        if pingAdjusterEnabled then
            local ping = getPing()
            if ping >= pausePing then
                pingPaused = true
                updatePingStatus("Paused - high ping")
                waitForPingRecovery()
                continue
            end
        else
            pingPaused = false
        end

        if not runFastRep then break end

        -- Fire a small batch, then re-check latency before the next batch.
        -- This is more responsive than a long inner loop that can overshoot
        -- a latency spike before the adjuster gets a chance to pause.
        local batchStart = tick()
        while runFastRep and tick() - batchStart < 0.05 do
            if pingAdjusterEnabled and getPing() >= pausePing then
                break
            end
            for i = 1, repsPerTick do
                muscleEvent:FireServer("rep")
            end
            task.wait(0.01)
        end

        task.wait()
    end
    pingPaused = false
    updatePingStatus("Stopped")
end

FarmingTab:AddSwitch("Fast Rep", function(state)
    if state and not runFastRep then
        runFastRep = true
        task.spawn(fastRepLoop)
    elseif not state and runFastRep then
        runFastRep = false
    end
end)




